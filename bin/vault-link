#!/usr/bin/env bash
set -eo pipefail

die() { printf '[vault-link] %s\n' "$*" >&2; exit 1; }
say() { printf '[vault-link] %s\n' "$*"; }

BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
OS_NAME="$(uname -s)"
CONFIG=.vault-link-local
changes=0

path_for_shell() {
  local path="$1" drive
  case "$OS_NAME" in
    MINGW*|MSYS*|CYGWIN*)
      if [[ "$path" = /mnt/[a-zA-Z]/* ]]; then path="${path#/mnt}"; fi
      cygpath -au "$path" ;;
    Linux)
      if [[ "$path" =~ ^([a-zA-Z]):[/\\] ]]; then
        drive="$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')"
        if [ -d "/mnt/$drive" ]; then path="/mnt/$drive/${path:3}"; path="${path//\\//}"; fi
      fi
      printf '%s\n' "$path" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

show_help() {
  printf '%s\n' \
    'Usage: vault-link --install' \
    '       vault-link [--check] --local DIR [PROJECT_DIR]' \
    '       vault-link [--check] --repo GIT_URL [PROJECT_DIR]' \
    '       vault-link --link-created [--check] --local DIR PROJECT_DIR' \
    '       vault-link --link-created [--check] --repo GIT_URL PROJECT_DIR' \
    '       vault-link [--check | --update] [PROJECT_DIR]' \
    '' 'Run from the project root or pass its path. --check previews project changes.' \
    '' 'Use --link-created only after the user explicitly requested project creation from the vault.'
}

install_portable() {
  local target launcher
  target="$(path_for_shell "${VAULT_LINK_BIN:-$HOME/.local/bin}")"
  mkdir -p "$target"
  target="$(cd "$target" && pwd -P)"
  if [ "$target" != "$BIN" ]; then
    for launcher in vault-link vault-link.cmd vault-link.ps1; do
      if ! cmp -s "$BIN/$launcher" "$target/$launcher"; then
        cp "$BIN/$launcher" "$target/$launcher"
      fi
    done
    legacy="$target/vault-link-legacy"
    if [ -f "$legacy" ] && [ ! -L "$legacy" ] && grep -qE 'vl_launch|TAREKVAULT' "$legacy"; then
      rm -- "$legacy"
      rm -f -- "$target/.vault-link-checkout"
      say "Removed legacy launcher."
    fi
  fi
  chmod +x "$target/vault-link"
  say "Installed in $target. Add this directory to PATH if needed."
}

# Allow standard Git transports without accepting credentials in HTTPS URLs.
validate_repo() {
  if [[ "$1" =~ ^https://[^/@[:space:]]+/[^[:space:]?\#]+$ ||
        "$1" =~ ^ssh://[^/[:space:]]+/[^[:space:]?\#]+$ ||
        "$1" =~ ^git@[^:[:space:]]+:[^[:space:]?\#]+$ ]]; then
    # An SSH username is permitted. Passwords and URL userinfo tokens are not.
    if [[ "$1" = ssh://* ]]; then
      local authority="${1#ssh://}"
      authority="${authority%%/*}"
      [[ "$authority" != *:*@* ]] || die 'Use a credential-free SSH URL.'
    fi
    return
  fi
  die 'Use a Git HTTPS or SSH URL without embedded credentials, query parameters, or fragments.'
}

set_link() {
  local dest="$1" draft="$2" name
  name="${dest##*/}"
  if [ -f "$dest" ] && cmp -s "$dest" "$draft"; then return; fi
  changes=$((changes + 1))
  if [ "$check" = yes ]; then
    say "Would write $name."
    return
  fi
  local adjacent
  adjacent="$(mktemp "$project/.$name.vault-link.XXXXXX")"
  if ! { [ ! -f "$dest" ] || cp -p "$dest" "$adjacent"; } ||
     ! cat "$draft" >"$adjacent" || ! mv -f "$adjacent" "$dest"; then
    rm -f "$adjacent"
    die "Could not write $name."
  fi
  say "Wrote $name."
}

explicit="" source_type="" source_value="" check=no update=no install=no programmatic=no operands=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help|-h) show_help; exit ;;
    --local|--repo)
      [ -z "$explicit" ] || die 'Choose one source with --local or --repo.'
      [ "$#" -ge 2 ] && [[ "$2" != --* ]] || die "$1 needs a value."
      explicit=1; source_type="${1#--}"; source_value="$2"; shift ;;
    --check) check=yes ;;
    --link-created) programmatic=yes ;;
    --update) update=yes ;;
    --install) install=yes ;;
    --*) die "Unknown option: $1" ;;
    *) operands+=("$1") ;;
  esac
  shift
done
if [ "$install" = yes ]; then
  [ -z "$explicit" ] && [ "$check$update" = nono ] && [ "${#operands[@]}" -eq 0 ] || die 'Use --install on its own.'
  install_portable
  exit
fi

if [ "$programmatic" = yes ]; then
  [ -n "$explicit" ] || die '--link-created requires an explicit --local or --repo source.'
  [ "$update" = no ] || die '--link-created cannot be combined with --update.'
  [ "${#operands[@]}" -eq 1 ] || die '--link-created requires the existing project directory created by the agent.'
fi

candidate="$(path_for_shell "${operands[0]:-$PWD}")"
if [ -z "$explicit" ] && [ ! -f "$candidate/$CONFIG" ] && [ ! -L "$candidate/$CONFIG" ]; then
  die 'Choose --local DIR or --repo GIT_URL to link a project.'
fi
[ "${#operands[@]}" -le 1 ] || die 'Pass one project directory for this vault link.'
[ -d "$candidate" ] || die 'The project directory does not exist.'
project="$(cd "$candidate" && pwd -P)"
if [ "$programmatic" = yes ]; then say "Linking the explicitly requested, already-created project: $project"; fi
for name in "$CONFIG" AGENTS.md .gitignore; do
  [ ! -L "$project/$name" ] || die "Refusing to edit a symlink: $name"
  [ ! -e "$project/$name" ] || [ -f "$project/$name" ] || die "Expected a file: $name"
done
if git -C "$project" ls-files --error-unmatch -- "$CONFIG" >/dev/null 2>&1; then
  die "Remove $CONFIG from the Git index before linking. It stores machine-local paths."
fi
if [ -z "$explicit" ]; then
  source_type="$(sed -n 's/\r$//; s/^source: //p' "$project/$CONFIG")"
  case "$source_type" in
    local) source_value="$(sed -n 's/\r$//; s/^vault_path: //p' "$project/$CONFIG")" ;;
    repo) source_value="$(sed -n 's/\r$//; s/^vault_repo: //p' "$project/$CONFIG")" ;;
    *) die "Invalid source in $CONFIG. Specify --local or --repo again." ;;
  esac
fi
[[ "$source_value" != *$'\n'* && "$source_value" != *$'\r'* && -n "$source_value" ]] || die 'Invalid vault source.'

if [ "$source_type" = local ]; then
  local_dir="$(path_for_shell "$source_value")"
  [ -d "$local_dir" ] || die 'The local vault folder does not exist.'
  vault="$(cd "$local_dir" && pwd -P)"
else
  validate_repo "$source_value"
  cache="$(path_for_shell "${VAULT_LINK_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/vault-link}")"
  key="$(printf '%s' "$source_value" | git hash-object --stdin)"
  vault="$cache/$key"
  [[ "$vault/" != "$project/"* ]] || die 'Set VAULT_LINK_CACHE outside the project.'
  [ ! -L "$vault" ] || die 'The cache path is a symlink.'
fi

scratch="$(mktemp -d)"
trap 'rm -rf -- "$scratch"' EXIT
if [ "$source_type" = local ]; then
  project_key="$project"; vault_key="$vault"
  case "$OS_NAME" in
    MINGW*|MSYS*|CYGWIN*)
      project_key="$(cygpath -am "$project" | tr '[:upper:]' '[:lower:]')"
      vault_key="$(cygpath -am "$vault" | tr '[:upper:]' '[:lower:]')" ;;
  esac
  [[ "$project_key/" != "$vault_key/"* ]] || die 'Run this command from a project outside the vault.'
fi
cat >"$scratch/block" <<'EOF'
<!-- vault-link:start -->
## Linked Second Brain — TarekVault

### Instruction priority
1. Read this project's root `AGENTS.md` first. It is the primary authority for project work, commands, architecture, coding standards, and repository changes.
2. Treat the linked vault as Tarek's **Second Brain**: shared context across Claude, ChatGPT, Gemini, Codex, and other agents.
3. Vault rules apply only when reading or changing the vault. Before every vault write, read the vault's `AGENTS.md`, router `README.md`, [[agents/skills/agent-write-method/SKILL|Agent Write Method]], and relevant Obsidian writing skill.

### Create a project from the vault (explicit opt-in)
- Never scan, discover, monitor, or automatically link other project folders. Existing projects are linked only when Tarek explicitly runs the normal link command from that project.
- When Tarek explicitly asks to create a project from this vault, first confirm the exact project name/slug, target directory, and source material (local folders or repositories). Use the coding agent's local filesystem access to inspect the supplied sources and create the project scaffold in the requested target directory.
- The CLI does not generate application code or project scaffolds. After the project directory exists, invoke the same Vault Link core with the explicit programmatic trigger:
  - Windows: `vault-link --link-created --local "<absolute vault path>" "<absolute project path>"`
  - Git-hosted vault: `vault-link --link-created --repo "<credential-free Git URL>" "<absolute project path>"`
- `--link-created` requires an explicit vault source and an existing project directory. It only performs the normal idempotent linking/configuration; it does not create the project.
- Verify the generated managed block, ignored `.vault-link-local`, and agent imports. If already linked, the command should leave the project unchanged.
- Do not link unrelated existing projects or infer that every project in a workspace belongs in TarekVault.

### Find and read the vault
- Read `vault_path:` from this project's ignored `.vault-link-local`. If missing or invalid, ask Tarek for the local vault path or Git URL. Never guess.
- Before the first TarekVault read/search, run `git pull --rebase --autostash` and check `git status -sb`. If sync fails or the branch is behind, do not use stale content for decisions or writes; tell Tarek.
- After syncing, read vault `AGENTS.md` and root `README.md`, then open the canonical `projects/<slug>/README.md` for this project. Follow only relevant links; do not load the whole vault.
- Before every TarekVault write, sync again and check `git status -sb`. Follow the vault's own sync rules for other vaults.

### Canonical project brief
- The vault's `projects/<slug>/README.md` is the **canonical Agent Project Brief** and shared project context for every model. It is not a copy of this repository's public README and does not need to follow its audience or structure.
- Keep it concise but useful: purpose, architecture, requirements, constraints, key decisions, verified current state, known issues, next step, and relevant workflow links.
- Update it in place whenever verified project facts change. Replace stale facts; never append session summaries, activity logs, task histories, or chronological changelogs.
- Keep this repository's own README current for its users when installation, setup, usage, or public behavior changes.
- Repository code, configuration, and tests are evidence of implementation. If they conflict with the Vault brief, inspect and reconcile; do not blindly trust either.
- Identify an existing Vault project by repository URL or project identity. Edit it rather than creating a duplicate. If absent, create one README from the vault's project template and add it to `projects/README.md`.

### Reusable workflows
- Search `agents/workflows/README.md` before creating a workflow.
- If a relevant workflow exists, link it from the project brief with an Obsidian wikilink. Do not copy its steps into the project README.
- If a genuinely reusable process is new, create a separate note under `agents/workflows/`, follow Agent Write Method and Obsidian conventions, add it to the workflows index, and link it from the project brief.
- Do not turn one-off task steps into permanent workflows.

### Durable personal memory
- Ask Tarek for explicit approval before saving or changing durable personal preferences, habits, or reusable skills. Show the proposed content and exact destination first.
- Project README updates and project-specific workflow references are normal project documentation and do not require per-edit approval.
- Never save speculative inferences.

### No activity logging
Never create session logs, conversation summaries, transcripts, hand-offs, agent-log rows, inbox captures, journal entries, or routine activity histories through this integration.

### Sync and reporting
- Before every vault write, sync again with `git pull --rebase --autostash` and check `git status -sb`. If pull fails or the branch is behind, do not write; tell Tarek the vault may be stale.
- After a vault write, report the exact file path and one line describing the change. Follow the vault's Git rules for commit and push. Never force-push or store secrets.
- Do not claim an update unless it was actually committed and pushed successfully.
<!-- vault-link:end -->
EOF
if [ -f "$project/AGENTS.md" ]; then
  # Replace one complete managed block, including the original bridge markers.
  awk -v block="$scratch/block" '
    function insert(    line) {
      while ((getline line < block)>0) print line ending
      close(block)
    }
    NR==1 && /\r$/ { ending="\r" }
    /^<!-- vault-(link|bridge):start -->\r?$/ {
      if (found++ || active) { invalid=1; exit }
      active=$0; sub(/:start.*/, "", active)
      insert(); next
    }
    /^<!-- vault-(link|bridge):end -->\r?$/ {
      if (!active || index($0,active ":end")!=1) { invalid=1; exit }
      active=""; next
    }
    !active { print }
    END {
      if (active || invalid) exit 1
      if (!found) { if (NR) print ending; insert() }
    }' "$project/AGENTS.md" >"$scratch/agents" || die 'AGENTS.md has incomplete or repeated vault-link markers.'
else
  cp "$scratch/block" "$scratch/agents"
fi

if [ "$source_type" = repo ]; then
  if [ "$check" = yes ]; then
    say 'Would clone or refresh the vault cache.'
  elif [ ! -e "$vault" ]; then
    mkdir -p "$cache"
    git clone --quiet -- "$source_value" "$vault" || die 'Could not clone the vault. Check Git access and retry.'
  else
    [ -d "$vault/.git" ] && [ "$(git -C "$vault" config --get remote.origin.url)" = "$source_value" ] ||
      die 'The cache does not belong to this repository.'
    [ -z "$(git -C "$vault" status --porcelain)" ] || die 'The vault cache has local edits.'
    git -C "$vault" pull --ff-only --quiet || die 'Could not refresh the vault cache.'
  fi
fi

stored_path="$vault"
case "$OS_NAME" in
  MINGW*|MSYS*|CYGWIN*) stored_path="$(cygpath -am "$vault")" ;;
esac
printf 'source: %s\nvault_path: %s\n' "$source_type" "$stored_path" >"$scratch/config"
if [ "$source_type" = repo ]; then printf 'vault_repo: %s\n' "$source_value" >>"$scratch/config"; fi
if [ ! -f "$project/.gitignore" ] ||
   ! grep -Eq '^/?\.vault-link-local\r?$' "$project/.gitignore" ||
   { git -C "$project" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
     ! git -C "$project" check-ignore -q --no-index -- "$CONFIG"; }; then
  if [ -f "$project/.gitignore" ]; then
    cat "$project/.gitignore" >"$scratch/ignore"
    if [ -n "$(tail -c 1 "$project/.gitignore")" ]; then printf '\n' >>"$scratch/ignore"; fi
  fi
  printf '/.vault-link-local\n' >>"$scratch/ignore"
  set_link "$project/.gitignore" "$scratch/ignore"
fi
set_link "$project/$CONFIG" "$scratch/config"
set_link "$project/AGENTS.md" "$scratch/agents"
for name in CLAUDE.md GEMINI.md; do
  alias_file="$project/$name"
  if [ -L "$alias_file" ]; then
    [ "$(readlink "$alias_file")" = AGENTS.md ] || say "Kept custom $name symlink."
    continue
  fi
  if [ -e "$alias_file" ] && [ ! -f "$alias_file" ]; then
    say "Skipped $name because it is not a regular file."
    continue
  fi
  : >"$scratch/alias"
  if [ -f "$alias_file" ]; then
    if grep -Eq '^@(\./)?AGENTS\.md[[:space:]]*$' "$alias_file"; then continue; fi
    cat "$alias_file" >"$scratch/alias"
    if [ -s "$alias_file" ]; then printf '\n' >>"$scratch/alias"; fi
  fi
  printf '@AGENTS.md\n' >>"$scratch/alias"
  set_link "$alias_file" "$scratch/alias"
done
if [ "$changes" -eq 0 ]; then
  say 'Project link is up to date.'
elif [ "$check" = no ]; then
  say 'Vault linked.'
fi
